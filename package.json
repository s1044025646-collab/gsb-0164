{
  "name": "fir-lab",
  "version": "1.0.0",
  "description": "Local FIR filter design and streaming verification backend (TypeScript + Node.js + SQLite)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "fir-lab": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --experimental-sqlite dist/server.js",
    "dev": "node --experimental-sqlite --import tsx src/server.ts",
    "cli": "node --experimental-sqlite --import tsx src/cli/index.ts",
    "test": "node --experimental-sqlite --import tsx --test tests/*.test.ts",
    "demo": "node --experimental-sqlite --import tsx examples/demo.ts",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
