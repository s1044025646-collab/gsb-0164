{
  "name": "fir-flow",
  "version": "1.0.0",
  "description": "Local FIR filter design and streaming verification backend (API + CLI)",
  "type": "module",
  "bin": {
    "fir": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --experimental-sqlite dist/server.js",
    "dev": "node --experimental-sqlite --experimental-strip-types src/server.ts",
    "cli": "node --experimental-sqlite --experimental-strip-types src/cli/index.ts",
    "test": "node --experimental-sqlite --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "^5.6.0"
  }
}
